# Переменные окружения сборки (локально — в .env, на сервере — в настройках GitHub)
#
# ВНИМАНИЕ: в .env и в репозиторий не коммитить пароли и ключи.
# Секреты SMTP задаются в переменных окружения Yandex Cloud Function, а не здесь.

# Яндекс.Метрика ID (metrika.yandex.ru). Пока не задан — счётчик не подключается.
# YANDEX_METRIKA_ID=12345678

# URL обработчика формы (Yandex Cloud Function). Не секрет, задаётся как переменная
# репозитория PUBLIC_FORM_ENDPOINT для GitHub Actions. Локально — тут.
# PUBLIC_FORM_ENDPOINT=https://functions.yandexcloud.net/XXXXXXXX

# Переменные Cloud Function (задаются в консоли Yandex Cloud, не здесь):
# SMTP_USER, SMTP_PASSWORD (пароль приложения), MAIL_TO, ALLOWED_ORIGIN
