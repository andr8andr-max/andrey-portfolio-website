# Яндекс.Метрика ID (получить на metrika.yandex.ru)
# После установки ID счётчик подключится автоматически (компонент YandexMetrika.astro)
# YANDEX_METRIKA_ID=12345678

# Telegram Bot Token — НЕ сохранять в репозитории (только для backend)
# TELEGRAM_BOT_TOKEN=your_bot_token

# Telegram Chat ID — НЕ сохранять в репозитории (только для backend)
# TELEGRAM_CHAT_ID=your_chat_id

# Google Apps Script URL — НЕ сохранять в репозитории (только для backend)
# GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/...

# Адрес сайта (для production)
# SITE_URL=https://vibecoder.ru
