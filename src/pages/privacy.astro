---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Policy from '../../privacy_policy.md';
---

<MainLayout title="Политика конфиденциальности | Vibe-Coder" description="Политика конфиденциальности и обработки персональных данных Vibe-Coder.">
  <Header />
  <main id="main-content" class="flex-1 py-24 px-4">
    <div class="container-custom max-w-3xl policy">
      <Policy />
    </div>
  </main>
  <Footer />
</MainLayout>

<style is:global>
  .policy {
    color: rgb(203 213 225);
    line-height: 1.7;
  }
  .policy h1 {
    font-family: 'Onest', sans-serif;
    font-size: 1.875rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 1.5rem;
  }
  @media (min-width: 768px) {
    .policy h1 { font-size: 2.25rem; }
  }
  .policy h2 {
    font-size: 1.25rem;
    font-weight: 600;
    color: #f8fafc;
    margin: 2.5rem 0 1rem;
  }
  .policy h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: #f8fafc;
    margin: 1.5rem 0 0.75rem;
  }
  .policy p {
    margin: 0.75rem 0;
  }
  .policy ul,
  .policy ol {
    margin: 0.75rem 0;
    padding-left: 1.5rem;
    list-style: disc;
  }
  .policy ol { list-style: decimal; }
  .policy li { margin: 0.25rem 0; }
  .policy hr {
    border: 0;
    border-top: 1px solid rgb(51 65 85);
    margin: 2rem 0;
  }
  .policy a {
    color: #22c55e;
    text-decoration: underline;
    text-underline-offset: 3px;
    word-break: break-word;
  }
  .policy strong { color: #f8fafc; font-weight: 600; }
</style>
