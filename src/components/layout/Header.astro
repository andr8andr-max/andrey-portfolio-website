---
---
<header class="fixed top-0 left-0 right-0 z-50 bg-dark-950/80 backdrop-blur-md border-b border-dark-800 transition-colors duration-200">
  <nav class="container-custom px-4 sm:px-6 lg:px-8" aria-label="Основная навигация">
    <div class="flex items-center justify-between h-16 sm:h-16">
      <a href="/" class="flex items-center gap-2 text-xl font-heading font-bold text-white hover:text-accent transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-dark-950 rounded-lg" aria-label="Vibe-Coder — главная">
        <span class="text-accent">VC</span>
        <span class="hidden sm:inline">Vibe-Coder</span>
      </a>

      <div class="hidden md:flex items-center gap-8">
        <a href="#services" class="text-sm font-medium text-dark-300 hover:text-white transition-colors duration-200 relative after:absolute after:bottom-[-4px] after:left-0 after:h-0.5 after:w-0 after:bg-accent after:transition-all hover:after:w-full">Услуги</a>
        <a href="#cases" class="text-sm font-medium text-dark-300 hover:text-white transition-colors duration-200 relative after:absolute after:bottom-[-4px] after:left-0 after:h-0.5 after:w-0 after:bg-accent after:transition-all hover:after:w-full">Кейсы</a>
        <a href="#about" class="text-sm font-medium text-dark-300 hover:text-white transition-colors duration-200 relative after:absolute after:bottom-[-4px] after:left-0 after:h-0.5 after:w-0 after:bg-accent after:transition-all hover:after:w-full">Обо мне</a>
        <a href="#pricing" class="text-sm font-medium text-dark-300 hover:text-white transition-colors duration-200 relative after:absolute after:bottom-[-4px] after:left-0 after:h-0.5 after:w-0 after:bg-accent after:transition-all hover:after:w-full">Цены</a>
        <a href="#process" class="text-sm font-medium text-dark-300 hover:text-white transition-colors duration-200 relative after:absolute after:bottom-[-4px] after:left-0 after:h-0.5 after:w-0 after:bg-accent after:transition-all hover:after:w-full">Как я работаю</a>
        <a href="#faq" class="text-sm font-medium text-dark-300 hover:text-white transition-colors duration-200 relative after:absolute after:bottom-[-4px] after:left-0 after:h-0.5 after:w-0 after:bg-accent after:transition-all hover:after:w-full">FAQ</a>
        <a href="#contact" class="text-sm font-medium text-dark-300 hover:text-white transition-colors duration-200 relative after:absolute after:bottom-[-4px] after:left-0 after:h-0.5 after:w-0 after:bg-accent after:transition-all hover:after:w-full">Контакты</a>
      </div>

      <div class="flex items-center gap-3">
        <a href="#contact" class="hidden sm:inline-flex btn-primary text-sm">Обсудить задачу</a>
        <button type="button" class="md:hidden p-2 rounded-lg text-dark-300 hover:text-white hover:bg-dark-800 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" aria-label="Открыть меню" aria-expanded="false" aria-controls="mobile-menu" id="menu-toggle">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <div class="md:hidden overflow-hidden transition-all duration-300 ease-in-out max-h-0" id="mobile-menu" role="navigation" aria-label="Мобильное меню">
      <div class="py-4 space-y-2 border-t border-dark-800">
        <a href="#services" class="block px-4 py-3 text-base font-medium text-dark-300 hover:text-white hover:bg-dark-800/50 rounded-xl transition-colors duration-200">Услуги</a>
        <a href="#cases" class="block px-4 py-3 text-base font-medium text-dark-300 hover:text-white hover:bg-dark-800/50 rounded-xl transition-colors duration-200">Кейсы</a>
        <a href="#about" class="block px-4 py-3 text-base font-medium text-dark-300 hover:text-white hover:bg-dark-800/50 rounded-xl transition-colors duration-200">Обо мне</a>
        <a href="#pricing" class="block px-4 py-3 text-base font-medium text-dark-300 hover:text-white hover:bg-dark-800/50 rounded-xl transition-colors duration-200">Цены</a>
        <a href="#process" class="block px-4 py-3 text-base font-medium text-dark-300 hover:text-white hover:bg-dark-800/50 rounded-xl transition-colors duration-200">Как я работаю</a>
        <a href="#faq" class="block px-4 py-3 text-base font-medium text-dark-300 hover:text-white hover:bg-dark-800/50 rounded-xl transition-colors duration-200">FAQ</a>
        <a href="#contact" class="block px-4 py-3 text-base font-medium text-dark-300 hover:text-white hover:bg-dark-800/50 rounded-xl transition-colors duration-200">Контакты</a>
        <a href="#contact" class="block mx-4 mt-4 btn-primary text-center">Обсудить задачу</a>
      </div>
    </div>
  </nav>
</header>